# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# IA (solo servidor). Sin AI_API_KEY el análisis por foto y por texto responde "no disponible".
# AI_PROVIDER: por ahora solo `anthropic` (por defecto). AI_MODEL: por defecto claude-sonnet-5-5.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Límites por usuario y por día (por defecto 20 fotos y 100 textos). 0 desactiva ese análisis.
AI_DAILY_PHOTO_LIMIT=
AI_DAILY_TEXT_LIMIT=
# Solo para pruebas o un proxy: URL base de la API del proveedor.
AI_BASE_URL=

# Allowlist de registro: emails separados por coma. Se carga en la tabla public.allowed_emails
# con `pnpm db:seed-allowlist` (el hook de Auth lee la tabla, no esta variable).
ALLOWED_EMAILS=

# Alimentos: key gratuita de USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup).
# Opcional: sin ella se omite USDA. Solo servidor.
USDA_API_KEY=
# User-Agent para Open Food Facts (pide identificar la app y un contacto). Opcional.
FOODS_USER_AGENT=
