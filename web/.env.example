# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# IA (solo servidor). Sin AI_API_KEY el análisis por foto y por texto responde "no disponible".
# AI_PROVIDER: `anthropic` (por defecto) o `gemini` (tiene plan gratuito). AI_MODEL: por defecto
# claude-sonnet-5-5 con anthropic y gemini-3.5-flash-lite con gemini.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Límites por usuario y por día (por defecto 20 fotos y 100 textos). 0 desactiva ese análisis.
AI_DAILY_PHOTO_LIMIT=
AI_DAILY_TEXT_LIMIT=
# Solo para pruebas o un proxy: URL base de la API del proveedor.
AI_BASE_URL=
# 1 = registra en el servidor la respuesta cruda del modelo cuando no se puede interpretar (solo para depurar).
AI_DEBUG=

# Allowlist de registro: emails separados por coma. Se carga en la tabla public.allowed_emails
# con `pnpm db:seed-allowlist` (el hook de Auth lee la tabla, no esta variable).
ALLOWED_EMAILS=

# Alimentos: key gratuita de USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup).
# Opcional: sin ella se omite USDA. Solo servidor.
USDA_API_KEY=
# User-Agent para Open Food Facts (pide identificar la app y un contacto). Opcional.
FOODS_USER_AGENT=

# Recordatorios con Web Push (solo servidor). Se generan una vez con `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY es pública (se le pasa al navegador); VAPID_PRIVATE_KEY es secreta.
# VAPID_SUBJECT: un contacto, `mailto:tu@email.com` o una URL https. Sin estas tres los avisos no se pueden activar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Secreto de la tarea programada que envía los avisos (`GET /api/cron/reminders` con `Authorization: Bearer <secreto>`).
# Cualquier texto largo y aleatorio. Sin él el endpoint responde 503 (cerrado).
CRON_SECRET=
